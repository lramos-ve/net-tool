[Unit]
Description=Net-Tool CCTV Monitor - Dashboard Web (Streamlit)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=netmonitor
Group=netmonitor
WorkingDirectory=/opt/net-tool
Environment=PYTHONUNBUFFERED=1
Environment=NET_MONITOR_CONFIG=/opt/net-tool/config.json
ExecStart=/opt/net-tool/.venv/bin/streamlit run app/dashboard.py --server.address 0.0.0.0 --server.port 8080 --server.headless true
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
